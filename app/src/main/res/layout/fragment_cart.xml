<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@color/frothy_white">

    <TextView
        android:id="@+id/tvEmptyCart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Keranjang masih kosong\nYuk pilih makanan atau minuman favoritmu!"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textColor="@color/roasted_caramel" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvCartTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:padding="14dp"
        android:text="Total: Rp0"
        android:textColor="@color/espresso_brown"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>