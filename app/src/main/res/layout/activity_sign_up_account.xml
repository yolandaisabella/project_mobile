<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F2ED"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="24dp"
    tools:context=".project_yolan_3tie.Home.SignUpAccountActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Kembali"
            android:src="@drawable/ic_arrow_back"
            android:layout_gravity="start"
            app:tint="#4B2C20" />

        <ImageView
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_gravity="center"
            android:layout_marginTop="18dp"
            android:contentDescription="Logo Cafe Jambang"
            android:src="@drawable/logo"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:text="Buat Akun"
            android:textColor="#4B2C20"
            android:textSize="24sp"
            android:fontFamily="@font/poppins_bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:text="Langkah 2 dari 3 - Buat username &amp; password"
            android:textColor="#A67C52"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_medium" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/edittext_login"
            android:hint="Username"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="text"
            android:textColor="#4B2C20"
            android:textColorHint="#A67C52" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/edittext_login"
                android:hint="Password"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:inputType="textPassword"
                android:textColor="#4B2C20"
                android:textColorHint="#A67C52" />

            <ImageButton
                android:id="@+id/btnTogglePassword"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tampilkan/Sembunyikan Password"
                android:src="@drawable/ic_visibility_off"
                app:tint="#A67C52" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/layoutPasswordStrength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/pbPasswordStrength"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tvPasswordStrength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kekuatan Password: -"
                android:textSize="12sp"
                android:textColor="#A67C52"
                android:fontFamily="@font/poppins_medium" />

            <TextView
                android:id="@+id/tvRuleLength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="• Minimal 8 karakter"
                android:textSize="11sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvRuleUpperLower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="• Huruf besar &amp; kecil"
                android:textSize="11sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvRuleNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="• Memiliki angka (0-9)"
                android:textSize="11sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvRuleSpecial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="• Memiliki karakter khusus (!@#$%^&amp;*)"
                android:textSize="11sp"
                android:textColor="#888888" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/edittext_login"
                android:hint="Confirm Password"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:inputType="textPassword"
                android:textColor="#4B2C20"
                android:textColorHint="#A67C52" />

            <ImageButton
                android:id="@+id/btnToggleConfirmPassword"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tampilkan/Sembunyikan Confirm Password"
                android:src="@drawable/ic_visibility_off"
                app:tint="#A67C52" />
        </FrameLayout>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#4B2C20"
            android:text="Selanjutnya"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/poppins_bold" />

    </LinearLayout>
</ScrollView>