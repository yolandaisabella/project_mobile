<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Ikon / Gambar Menu -->
        <TextView
            android:id="@+id/tvCoffeeIcon"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:background="@drawable/bg_coffee_icon"
            android:gravity="center"
            android:text="☕"
            android:textSize="42sp" />

        <!-- Nama Menu -->
        <TextView
            android:id="@+id/tvCoffeeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Nama Menu"
            android:textColor="@color/espresso_brown"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Deskripsi Singkat -->
        <TextView
            android:id="@+id/tvCoffeeDescription"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:text="Deskripsi"
            android:textColor="@color/roasted_caramel"
            android:textSize="10sp" />

        <!-- Harga Menu -->
        <TextView
            android:id="@+id/tvCoffeePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rp0"
            android:textColor="@color/espresso_brown"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Tombol Pilih -->
        <Button
            android:id="@+id/btnAddCoffee"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="7dp"
            android:backgroundTint="@color/espresso_brown"
            android:text="Pilih"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>