<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F2ED"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="24dp"
    tools:context=".project_yolan_3tie.Home.VerifikasiActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Kembali"
            android:src="@drawable/ic_arrow_back"
            android:layout_gravity="start"
            app:tint="#4B2C20" />

        <ImageView
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_gravity="center"
            android:layout_marginTop="18dp"
            android:contentDescription="Logo Cafe Jambang"
            android:src="@drawable/logo"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:text="Verifikasi Data Registrasi"
            android:textColor="#4B2C20"
            android:textSize="22sp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:text="Langkah 3 dari 3 - Periksa kembali data kamu sebelum menyelesaikan pendaftaran"
            android:textColor="#A67C52"
            android:textSize="13sp"
            android:gravity="center"
            android:fontFamily="@font/poppins_medium" />

        <!-- Card Tampilan Data Registrasi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/edittext_login"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detail Akun &amp; Data Diri:"
                android:textColor="#4B2C20"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvNama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama: -"
                android:textColor="#4B2C20"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email: -"
                android:textColor="#4B2C20"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/tvTanggalLahir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tanggal Lahir: -"
                android:textColor="#4B2C20"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/tvJenisKelamin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jenis Kelamin: -"
                android:textColor="#4B2C20"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username: -"
                android:textColor="#4B2C20"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#4B2C20"
            android:text="Verifikasi &amp; Submit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/poppins_bold" />

        <Button
            android:id="@+id/btnKembali"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/fresh_mint"
            android:text="Kembali"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins_bold" />

    </LinearLayout>
</ScrollView>