<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Gambar Produk -->
        <ImageView
            android:id="@+id/ivCartImage"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_coffee_icon"
            android:contentDescription="Foto produk di keranjang"
            android:scaleType="centerCrop" />

        <!-- Nama & Harga Produk -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvCartName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Produk"
                android:textColor="@color/espresso_brown"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCartPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rp0"
                android:textColor="@color/roasted_caramel"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Kontrol Jumlah (Minus, Qty, Plus) -->
        <TextView
            android:id="@+id/btnCartMinus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_coffee_icon"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/espresso_brown"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvCartQuantity"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/espresso_brown"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCartPlus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_coffee_icon"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/espresso_brown"
            android:textSize="20sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>